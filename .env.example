# Copy to .env and fill in. Never commit .env.
APP_PASSWORD=change-me
# Long random string, e.g. output of: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
ANTHROPIC_API_KEY=
# Speech-to-text API key (used only when a recipe is spoken, not written in the caption)
TRANSCRIBE_API_KEY=
# Optional: path to a cookies.txt for Instagram posts that require login
YTDLP_COOKIES=
DATA_DIR=data
PORT=8080
