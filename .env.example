# Copy to .env and fill in. Never commit .env.
APP_PASSWORD=change-me
# Long random string, e.g. output of: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
ANTHROPIC_API_KEY=
# Claude model for reading recipes (claude-haiku-5-5 is much cheaper; try it if quality holds)
CLAUDE_MODEL=claude-opus-5-5
# OpenAI API key for speech-to-text (used only when a recipe is spoken, not written in the caption)
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
# Optional: path to a cookies.txt for Instagram posts that require login
YTDLP_COOKIES=
DATA_DIR=data
PORT=8080
