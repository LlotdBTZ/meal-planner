[Unit]
Description=Meal Planner web app
Documentation=https://github.com/LlotdBTZ/meal-planner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mealplanner
Group=mealplanner
WorkingDirectory=/opt/meal-planner/current
Environment=MEAL_PLANNER_ENV_FILE=/etc/meal-planner/.env
# Real environment wins over .env, so the data location is fixed here.
Environment=DATA_DIR=/var/lib/meal-planner
Environment=HOME=/var/lib/meal-planner
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/meal-planner/venv/bin/python -m app.main
Restart=on-failure
RestartSec=5

# Never let the app starve Pi-hole of memory or CPU.
MemoryMax=300M
CPUWeight=50

# Hardening: the app may only write its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/meal-planner

[Install]
WantedBy=multi-user.target
